[Unit]
Description=Tesla Linux — tmux SSH MOTD (not HDMI tty1, not a login)
# Do not attach this unit to tty1. Opening tty1 stole USB KBM from XFCE :0.
# getty@tty1 stays masked. Xorg :0 vt1 + libinput GrabDevice own HID.
# Do not After/Requires xorg or desktop. Do not Before=nginx.
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=teslalinux
RuntimeDirectory=tesla-linux
RuntimeDirectoryMode=0770
Environment=HOME=/home/teslalinux
Environment=BANNER_FILE=/run/tesla-linux/hdmi-banner
Environment=TMUX_SOCK=/run/tesla-linux/tmux.sock
ExecStart=/usr/local/sbin/tesla-linux-hdmi-banner daemon
Restart=always
RestartSec=2
StandardInput=null
# No PAMName / no TTYPath — do not take a console seat or USB KBM.

[Install]
WantedBy=multi-user.target
