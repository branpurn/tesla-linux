[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "https://m.youtube.com/\\1"
      }
    },
    "condition": {
      "regexFilter": "^https?://(?:www\\.)?youtube\\.com/(.*)$",
      "resourceTypes": [
        "main_frame"
      ]
    }
  },
  {
    "id": 2,
    "priority": 3,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "User-Agent",
          "operation": "set",
          "value": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Mobile Safari/537.36"
        },
        {
          "header": "sec-ch-ua-mobile",
          "operation": "set",
          "value": "?1"
        },
        {
          "header": "sec-ch-ua-platform",
          "operation": "set",
          "value": "\"Android\""
        }
      ]
    },
    "condition": {
      "requestDomains": [
        "youtube.com",
        "googlevideo.com",
        "ytimg.com"
      ],
      "excludedRequestDomains": [
        "music.youtube.com",
        "studio.youtube.com",
        "tv.youtube.com",
        "accounts.youtube.com"
      ],
      "resourceTypes": [
        "main_frame",
        "sub_frame",
        "stylesheet",
        "script",
        "image",
        "font",
        "object",
        "xmlhttprequest",
        "ping",
        "csp_report",
        "media",
        "websocket",
        "webtransport",
        "webbundle",
        "other"
      ]
    }
  },
  {
