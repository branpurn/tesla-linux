[Unit]
Description=Tesla Linux WLAN (saved station else TeslaLinux hostapd AP, or WAN rebroadcast)
After=NetworkManager.service tesla-linux-firstboot.service
Wants=NetworkManager.service
# nginx After=/Wants= this unit (install drop-in) so it starts after listen files.
# Do not Before=nginx — a oneshot that systemctl-restarts nginx deadlocks.
# AP must not wait on HDMI/X — do not After/Requires tesla-linux-desktop or xorg.
# WAN rebroadcast is the helper boot path (wan-up), not a second unit.

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
# eth-up waits for delayed usb-net/cdc_ether. Missing wlan0 is not a unit fail when 10.42.1.1 is bound.
ExecStartPre=/usr/local/sbin/tesla-linux-wlan eth-up
ExecStart=/usr/local/sbin/tesla-linux-wlan boot
ExecStop=/usr/local/sbin/tesla-linux-wlan ap-down

[Install]
WantedBy=multi-user.target
