# Tesla Linux factory AP (WAVE 1). Operator default — not a secret.
# Change later; Frontend may expose this on the pick/save UI (this SHA).
AP_SSID=TeslaLinux
AP_PSK=teslalinux
AP_ADDR=10.42.0.1
AP_PREFIX=24
AP_DHCP_START=10.42.0.10
AP_DHCP_END=10.42.0.200
# Wired ethernet static — not DHCP, not the AP subnet.
ETH_ADDR=10.42.1.1
ETH_PREFIX=24
ETH_CONN=tesla-linux-eth
# Bounded wait for NetworkManager to associate a saved infra WLAN.
WAIT_SEC=20
# Bounded wait for delayed ifaces (brcmfmac/wlan0, usb-net/cdc_ether/eth0/en*).
IFACE_WAIT_SEC=60
# Operator override. Preferred persist is Backend /etc/tesla-linux/mode.json
# ({"mode":"wan_rebroadcast"}). Station-on-same-WLAN remains the other mode.
# See docs/WAN-REBROADCAST.md.
WAN_REBROADCAST=0
# Optional: force WAN uplink iface for NAT (e.g. enxac0033aa9633 or wwan0).
# Use when a new same-family LTE stick enumerates with a different name/driver.
# WAN_IFACE=
# Default known stick (Marvell cdc_ether). Comma-list additional VID:PID pairs
# for same-family replacements (lowercase hex, no 0x).
LTE_USB_VID=1286
LTE_USB_PID=4e3c
# LTE_USB_IDS=1286:4e3c,12d1:14dc
LTE_WAIT_SEC=15
# DHCP wait when iface is up but Health=no_ip (blank IPv4).
# LTE_DHCP_WAIT_SEC=30
# Optional ModemManager APN (mmcli --simple-connect). Leave blank to skip.
# LTE_APN=
# LTE_MODESWITCH=1

# LTE Health=no_ip recovery (2026.09.21+)
# WAN_IFACE=enxac0033aa9633
# LTE_APN=
# LTE_DHCP_WAIT_SEC=45
# LTE_DHCP_RETRIES=3
# LTE_DHCP_RETRY_GAP_SEC=20

# Concurrent station + AP (docs/STA-AP-CONCURRENT.md). TeslaLinux AP runs on the
# virtual iface AP_VIF next to the wlan0 station; channel follows the station
# (brcmfmac #channels<=1). No saved Wi-Fi in range → AP solo, wlan0 idle.
AP_CONCURRENT=1
AP_VIF=uap0
# Solo AP channel when no station has been associated this boot.
AP_CHANNEL=6
# Prefer Wi-Fi WAN (metric 50) over LTE (101) while the station is up.
WIFI_WAN_PREFER=1
WIFI_WAN_METRIC=50
# Solo: seconds between rejoin scans (tesla-linux-wlan-rejoin.timer fires every 30s).
REJOIN_SCAN_SEC=120
