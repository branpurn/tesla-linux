# Tesla Linux factory AP (WAVE 1). Operator default — not a secret.
# Change later; Frontend may expose this on the pick/save UI (this SHA).
AP_SSID=TeslaLinux
AP_PSK=teslalinux
AP_ADDR=10.42.0.1
AP_PREFIX=24
AP_DHCP_START=10.42.0.10
AP_DHCP_END=10.42.0.200
# Bounded wait for NetworkManager to associate a saved infra WLAN.
WAIT_SEC=20
